<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Bluefrog' Website on Bluefrog Pages</title><link>https://freewu.github.io/en/</link><description>Recent content in Bluefrog' Website on Bluefrog Pages</description><generator>Hugo</generator><language>en-US</language><lastBuildDate>Tue, 09 May 2023 00:00:00 +0000</lastBuildDate><atom:link href="https://freewu.github.io/en/index.xml" rel="self" type="application/rss+xml"/><item><title>LaTeX Tutorial</title><link>https://freewu.github.io/en/blog/latex-tutorial/</link><pubDate>Tue, 09 May 2023 00:00:00 +0000</pubDate><guid>https://freewu.github.io/en/blog/latex-tutorial/</guid><description>&lt;h2 id="superscripts-and-subscripts"&gt;Superscripts and subscripts&lt;/h2&gt;&#10;&lt;blockquote&gt;&#10;&lt;p&gt;Superscripts (Powers) are written with &lt;code&gt;^&lt;/code&gt;, e.g. n^2.&#10;Subscripts (Indices) are written with &lt;code&gt;_&lt;/code&gt;, e.g. a_2&lt;/p&gt;&#10;&lt;/blockquote&gt;&#10;&lt;div class="highlight"&gt;&lt;div style="color:#4d4d4d;background-color:#fff;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&#10;&lt;table style="border-spacing:0;padding:0;margin:0;border:0;"&gt;&lt;tr&gt;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;"&gt;&#10;&lt;pre tabindex="0" style="color:#4d4d4d;background-color:#fff;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;1&#10;&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;2&#10;&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;3&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%"&gt;&#10;&lt;pre tabindex="0" style="color:#4d4d4d;background-color:#fff;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-latex" data-lang="latex"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#0c6"&gt;$$&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;{^&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;1&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;_&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;2&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;}a{^&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;3&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;_&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;4&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;} &lt;/span&gt;&lt;span style="color:#2c5dcd"&gt;+&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt; n^&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;2&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt; &lt;/span&gt;&lt;span style="color:#2c5dcd"&gt;-&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt; a_&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;2&lt;/span&gt;&lt;span style="color:#5918bb;font-weight:bold"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#0c6"&gt;$$&lt;/span&gt;&#9;&#9;&#9;&#9;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;$$&#10;{^1_2}a{^3_4} + n^2 - a_2&#10;$$&lt;/p&gt;&#10;&lt;table&gt;&#10;&#9;&lt;thead&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th style="text-align: center"&gt;Input&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th style="text-align: center"&gt;Display&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th style="text-align: center"&gt;Input&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th style="text-align: center"&gt;Display&lt;/th&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/thead&gt;&#10;&#9;&lt;tbody&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;\langle&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;⟨⟨&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;\rangle&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;⟩⟩&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;\lceil&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;⌈⌈&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;\rceil&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;⌉⌉&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;\lfloor&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;⌊⌊&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;\rfloor&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;⌋⌋&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;\lbrace&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;{{&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;\rbrace&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td style="text-align: center"&gt;}&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&lt;p&gt;$$&#10;\langle&#9;⟨&#9;\rangle&#9;⟩&lt;br&gt;&#10;\lceil&#9;⌈&#9;\rceil&#9;⌉&lt;br&gt;&#10;\lfloor&#9;⌊&#9;\rfloor&#9;⌋&lt;br&gt;&#10;\lbrace&#9;{&#9;\rbrace&#9;}&#10;$$&lt;/p&gt;</description></item></channel></rss>